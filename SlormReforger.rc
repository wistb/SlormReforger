#include <winver.h>
#include "source/Version.hpp"

VS_VERSION_INFO VERSIONINFO
FILEVERSION SLORMREFORGER_MAJOR, SLORMREFORGER_MINOR, SLORMREFORGER_PATCH, 0
PRODUCTVERSION SLORMREFORGER_MAJOR, SLORMREFORGER_MINOR, SLORMREFORGER_PATCH, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "FileDescription", "SlormReforger"
			VALUE "FileVersion", SLORMREFORGER_VERSION
			VALUE "ProductName", "SlormReforger"
			VALUE "ProductVersion", SLORMREFORGER_VERSION
			VALUE "OriginalFilename", "SlormReforger.dll"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
